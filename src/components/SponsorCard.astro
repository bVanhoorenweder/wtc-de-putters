---
import type { Sponsor } from '../data/sponsors';

interface Props {
  sponsor: Sponsor;
}

const { sponsor } = Astro.props;
---

<div class="h-full flex flex-col group bg-white rounded-xl shadow-md hover:shadow-2xl transition-all duration-400 overflow-hidden hover:-translate-y-1 border-2 border-gray-100 hover:border-putters-primary">
  <!-- Header with logo -->
  <div class="bg-white p-6 flex items-center justify-center border-b border-gray-100 min-h-[120px]">
    <img
      src={sponsor.logo || '/assets/logo.png'}
      alt={sponsor.name}
      class="max-h-20 max-w-[200px] object-contain"
    />
  </div>

  <!-- Content - flex-1 to fill space -->
  <div class="flex-1 flex flex-col p-6">
    <!-- Name & Category -->
    <div class="text-center mb-4">
      <h3 class="text-xl font-heading font-bold text-putters-heading mb-1 group-hover:text-putters-primary transition-colors">
        {sponsor.name}
      </h3>
      <div class="text-xs uppercase tracking-wider text-putters-text/60 font-semibold">
        {sponsor.category}
      </div>
    </div>

    <!-- Description -->
    <p class="text-putters-text text-sm leading-relaxed mb-6 flex-1 text-justify">
      {sponsor.description}
    </p>

    <!-- Contact Info - at bottom -->
    <div class="space-y-2 border-t border-gray-100 pt-4 mt-auto">
      {sponsor.website && (
        <a
          href={sponsor.website}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-xs text-putters-text hover:text-putters-primary transition-colors"
        >
          <span class="text-base">🌐</span>
          <span class="flex-1 truncate">{sponsor.website.replace('https://', '')}</span>
        </a>
      )}

      {sponsor.email && (
        <a
          href={`mailto:${sponsor.email}`}
          class="flex items-center gap-2 text-xs text-putters-text hover:text-putters-primary transition-colors"
        >
          <span class="text-base">📧</span>
          <span class="flex-1 truncate">{sponsor.email}</span>
        </a>
      )}

      {sponsor.phone && (
        <a
          href={`tel:${sponsor.phone}`}
          class="flex items-center gap-2 text-xs text-putters-text hover:text-putters-primary transition-colors"
        >
          <span class="text-base">📞</span>
          <span class="truncate">{sponsor.phone}</span>
        </a>
      )}

      {sponsor.facebook && (
        <a
          href={sponsor.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-xs text-putters-text hover:text-putters-primary transition-colors"
        >
          <span class="text-base">👥</span>
          <span class="flex-1 truncate">Facebook</span>
        </a>
      )}
    </div>
  </div>
</div>
